            &none          &kp RET             &kp SPACE          &kp TAB             &kp BSPC            &kp _CUT                                                                                         &kp _C(R)        &kp _C(LS(LBKT))         &kp UP                   &kp _C(LS(RBKT))             &kp _C(W)  &kp Q
            &none          &sk_qrel PINKY_MOD  &sk_qrel RING_MOD  &sk_qrel MIDDY_MOD  &sk_qrel INDEX_MOD  &kp _COPY                                                                                        &vim_plus_yank   &kp LEFT                 &kp DOWN                 &kp RIGHT                    &none      &none
            &none          &kp _C(A)           &select_line       &select_word        &kp _FIND           &kp _PASTE   &mod_tab _A_TAB &none          &none     &select_none  &extend_line  &extend_word   &vim_plus_paste  &kp _HOME                &kp PG_UP                &kp PG_DN                    &kp _END   &none
            &kp LG(S)      &kp _UNDO           &kp _REDO          &kp _FIND_PREV      &kp _FIND_NEXT                   &none           &mod_tab LCTL  &none     &kp _C(A)     &select_line  &select_word                    &vim_y_paste             &vim_y_paste_insert_mode &vim_plus_paste_insert_mode  &none      &none
