            &star2_star2             &kp Q                   &kp W                 &kp D                   &kp L                   &en_l31                                                                                                                          &en_r31       &kp U                    &kp O                    &kp Y                  &kp Z                       &plus2_lbkt_rbkt
            &kp V                    &kp N                   &kp S                 &kp T                   &kp H                   &en_l41                                                                                                                          &en_r41       &kp A                    &kp E                    &kp I                  &kp C                       &kp B
            &tog_lang                &kp P                   &kp F                 &kp M                   &kp R                   &en_l51     &th FUN ESC              &equal_colon2  &none                  &caps_word    &kp TAB        &kp RET                  &en_r51       &kp K                    &kp J                    &kp X                  &kp G                       &caps_word
            &magic MAGIC 0           &sk_qrel PINKY_MOD      &sk_qrel RING_MOD     &sk_qrel MIDDY_MOD      &sk_qrel INDEX_MOD                  &th_mo_sk NAV BSPC       &en_lt5 NUM 0  &kp LC(LA(LG(SPACE)))  &scroll_down  &key_repeat    &th_no_repeat SYM SPACE                &sk_qrel INDEX_MOD       &sk_qrel MIDDY_MOD       &sk_qrel RING_MOD      &sk_qrel PINKY_MOD          &magic MAGIC 0
